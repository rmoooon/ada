#!/bin/sh
set -e

[ -d .xmake ] || xmake f -m debug --toolchain=clang

echo "pre-push: building"
xmake build

echo "pre-push: running tests"
xmake test

echo "pre-push: clang-tidy"
# Refresh the compdb: a stale one makes clang-tidy read BMIs from the other mode.
xmake project -k compile_commands --lsp=clangd >/dev/null
xmake check clang.tidy

echo "pre-push: OK"
